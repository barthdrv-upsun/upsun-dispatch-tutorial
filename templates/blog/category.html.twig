{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — Example Blog{% endblock %}
{% block meta_description %}Articles filed under {{ category.name }}.{% endblock %}

{% block body %}
    {% set accent = {
        'AI Engineering': 'text-brand-violet',
        'Platform Engineering': 'text-brand-blue',
        'Cloud Economics': 'text-[#9bb800]',
        'Architecture': 'text-brand-pink',
    }[category.name]|default('text-slatey-400') %}

    {# ── Hero ─────────────────────────────────────────────────────── #}
    <section class="relative overflow-hidden bg-hero-glow">
        <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_80%_-10%,rgba(0,80,255,0.18),transparent_60%)]"></div>
        <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-8">
            <div class="flex items-center justify-between text-white">
                {% include 'partials/_logo.html.twig' %}
                <a href="{{ path('home') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-white/55 transition-colors hover:text-white">
                    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 8H4m0 0 4-4M4 8l4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    All articles
                </a>
            </div>

            <span class="mt-12 block text-xs font-semibold uppercase tracking-wide {{ accent }}">Category</span>
            <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl">
                {{ category.name }}
            </h1>
            <p class="mt-5 text-lg leading-relaxed text-white/60">
                {{ category.count }} article{{ category.count == 1 ? '' : 's' }} in this category.
            </p>
        </div>
    </section>

    {# ── Articles in this category ────────────────────────────────── #}
    <section class="mx-auto max-w-6xl px-5 pt-12">
        {% include 'partials/_category_nav.html.twig' with { current: category.slug } %}

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for article in articles %}
                {% include 'partials/_article_card.html.twig' %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
